# Copy to .env. The key is read by server.js only — it never reaches the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional. Any Gemini model that supports structured output + thinking.
# gemini-2.5-flash (default) is cheap; gemini-2.5-pro is stronger.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. The API server's port; Vite proxies /api here in development.
# PORT=8787
